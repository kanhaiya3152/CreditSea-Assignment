PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/lms

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_NAME=lms_token
COOKIE_MAX_AGE_MS=604800000

# CORS - the origin the Next.js client runs on
CLIENT_ORIGIN=http://localhost:3000

# Cloudinary - salary slip storage (create a free account at cloudinary.com,
# these three values are on your dashboard home page)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
