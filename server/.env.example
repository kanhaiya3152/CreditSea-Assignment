PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/lms

# JWT - the signing secret for the bearer tokens the API issues on login/signup.
# Required: the server refuses to start without it.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - comma-separated list of allowed browser origins, no trailing slash.
# e.g. https://your-client.vercel.app,http://localhost:3000
# Leave empty to allow any origin (auth is a bearer token, not a cookie).
CLIENT_ORIGIN=http://localhost:3000

# Cloudinary - salary slip storage (create a free account at cloudinary.com,
# these three values are on your dashboard home page). Optional: if unset, only
# the salary-slip upload endpoint fails, the rest of the API still works.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
